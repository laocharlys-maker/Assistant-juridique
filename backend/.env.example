# --- Base de donnees ---
# "externe" (defaut) : DATABASE_URL ci-dessous est utilisee telle quelle,
#   comportement inchange depuis la Phase 0 (VPS Hostinger, ou toute autre
#   instance Postgres deja geree par ailleurs).
# "portable" (Lot 2, packaging desktop Tauri) : un cluster PostgreSQL portable
#   est initialise/demarre automatiquement au lancement de l'app dans
#   %APPDATA%/Aurore (Windows) - DATABASE_URL est alors calculee
#   dynamiquement et cette valeur ci-dessous est ignoree. Voir README-LOT2.md.
DATABASE_MODE=externe

# URL de connexion vers le serveur PostgreSQL existant (VPS Hostinger) ou
# local. Utilisee uniquement si DATABASE_MODE=externe.
# Ne jamais committer le fichier .env reel.
DATABASE_URL="postgresql://user:password@host:5432/aurore?schema=public"

# --- Postgres portable (Lot 2, utilise seulement si DATABASE_MODE=portable) ---
# Interface/port d'ecoute du cluster local. Port different de 5432 par
# defaut pour ne jamais entrer en conflit avec un Postgres systeme deja
# installe sur le poste.
POSTGRES_PORTABLE_HOST=127.0.0.1
POSTGRES_PORTABLE_PORT=5433
POSTGRES_PORTABLE_DATABASE=aurore
# Planification de la sauvegarde automatique (syntaxe cron standard) et
# nombre de sauvegardes conservees (les plus anciennes sont purgees au-dela).
# Voir README-LOT2.md pour la restauration manuelle.
POSTGRES_BACKUP_CRON="0 3 * * *"
POSTGRES_BACKUP_RETENTION=14

# --- Chiffrement au repos (Lot 2bis) ---
# Cle AES-256-GCM utilisee pour chiffrer/dechiffrer les champs sensibles
# (identite client, contenu des documents generes - voir README-LOT2BIS.md).
# Non requise dans l'usage normal : une cle unique est generee automatiquement
# a la premiere ecriture, dans le meme dossier protege que les identifiants
# Postgres portable (%APPDATA%/Aurore/secrets/encryption-key.json). Ne
# renseigner cette variable que pour une gestion de cle externalisee
# (coffre-fort secret gere par l'exploitant) - jamais commiter de valeur ici.
# Format : 32 octets encodes en base64 (ex: openssl rand -base64 32).
AURORE_ENCRYPTION_KEY=

# --- Licence (Lot 3) ---
# Endpoint du service de verification en ligne (Lot 4, Cloudflare Workers).
# Uniquement appele en mode "auto" (voir le champ modeVerification du
# fichier de licence) - jamais en mode "manuel", sauf action explicite sur
# le bouton "Verifier maintenant". Laisser vide utilise l'endpoint de
# production par defaut (voir LICENCE_PHONE_HOME_URL_DEFAUT,
# security/licenceManager.ts) - ne renseigner que pour pointer vers un
# autre serveur (dev/tests).
LICENCE_PHONE_HOME_URL=
# Duree de la periode de grace apres expiration, en jours (10-15 jours
# recommandes). 14 par defaut si absent.
LICENCE_GRACE_JOURS=14
# DEVELOPPEMENT LOCAL UNIQUEMENT - ignore automatiquement des que
# NODE_ENV=production (voir middleware/requireLicence.ts). Ne JAMAIS
# activer sur un poste de production : desactive entierement le controle de
# licence, y compris la periode de grace et le blocage.
LICENCE_BYPASS=false

# --- Serveur ---
PORT=3000
# Interface d'ecoute. "0.0.0.0" (defaut) pour le deploiement VPS actuel
# derriere Traefik. Le sidecar Tauri (packaging desktop, voir README-LOT1.md)
# force HOST=127.0.0.1 pour n'exposer le backend qu'en local.
HOST=0.0.0.0
NODE_ENV=development

# --- IA (Phase 1+, pas necessaire pour demarrer la Phase 0) ---
# Fournisseur actif pour extraction/redaction/recherche : "gemini", "anthropic" ou "groq"
LLM_PROVIDER=groq
# Gemini (gratuit en theorie, mais quota a 0 constate sur certains projets) : https://aistudio.google.com/apikey
# IMPORTANT : requis meme si LLM_PROVIDER != gemini, car utilise pour les
# embeddings du RAG jurisprudence (aucun autre fournisseur configure ne fait
# d'embeddings).
GEMINI_API_KEY=
# Claude (Anthropic, payant a l'usage) : rempli seulement si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Groq (gratuit, tres rapide, modeles open-source type Llama) : https://console.groq.com/keys
GROQ_API_KEY=
# Tavily : recherche web complementaire au RAG jurisprudence
TAVILY_API_KEY=
# Nombre minimum de sources Tavily (toutes categories de confiance
# confondues, apres deduplication) en-deca duquel un appel de secours sans
# restriction de domaine est declenche pour la Recherche de jurisprudence -
# voir services/jurisprudence/domainesConfiance.ts. 3 par defaut si absent.
JURISPRUDENCE_SEUIL_SOURCES_MINIMUM=3

# --- Synchronisation calendrier externe (Lot 12b) ---
# Un seul jeu de credentials OAuth2 Google pour toute l'installation ; chaque
# utilisateur connecte ensuite SON PROPRE compte Google individuellement
# depuis "Mon profil" (aucun compte cabinet partage). Procedure d'obtention
# (Google Cloud Console) detaillee dans README-LOT12B.md. Laisser vide en
# developpement si tu ne testes pas la connexion Google : le reste de l'app
# fonctionne normalement, seul le bouton "Connecter Google Calendar" echoue
# avec un message clair.
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
# Doit correspondre EXACTEMENT a l'URI de redirection autorisee dans Google
# Cloud Console. En local : http://127.0.0.1:3000/api/calendrier-externe/google/callback
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=

# --- Ingestion email assistee (Lot 16) ---
# Reutilise LE MEME client OAuth2 Google ci-dessus (GOOGLE_CALENDAR_OAUTH_
# CLIENT_ID/SECRET) mais avec une redirect_uri DISTINCTE (scope gmail.readonly,
# a autoriser separement dans Google Cloud Console). Egalement laissable vide
# en developpement : seul le bouton "Connecter Gmail" echoue proprement.
# En local : http://127.0.0.1:3000/api/email-ingestion/gmail/callback
GMAIL_INGESTION_OAUTH_REDIRECT_URI=

# --- n8n / WhatsApp / lien Google Docs (retires, Lot 8ter) ---
# Aurore utilisait n8n pour trois usages heritages du SaaS d'origine :
# notifications WhatsApp, generation d'un lien Google Docs editable, et
# rappels Google Calendar. Les trois sont abandonnes pour la version desktop
# (WhatsApp supprime du produit ; export Word/PDF natif remplace le lien
# Google Docs ; la page "Echeances" deja presente dans l'app remplace les
# rappels Calendar). Les emails de rappel/notification passent desormais
# uniquement par SMTP/Brevo (voir plus bas), deja en place pour l'envoi des
# documents. Variables retirees en consequence : N8N_WEBHOOK_BASE_URL,
# N8N_WEBHOOK_SECRET, EVOLUTION_API_URL, EVOLUTION_API_KEY,
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, PUBLIC_BASE_URL (n'avait plus
# d'autre usage que la construction d'un lien absolu pour n8n). Voir
# README-LOT8TER.md.

# --- Email (Brevo) - envoi direct des documents et emails, canal unique ---
# Lot 19 : l'envoi passe par l'API REST Brevo (BREVO_API_KEY), plus par SMTP -
# le relais SMTP de Brevo reecrivait le Message-ID cote serveur, rendant tout
# matching fiable impossible pour un futur lot de gestion des reponses.
# Cle API Brevo (differente de l'ancienne cle SMTP) : https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# SMTP_HOST/PORT/USER/PASSWORD ne sont plus utilisees par services/mailer.ts
# (conservees ici sans effet, au cas ou un retour en arriere SMTP serait
# necessaire un jour - voir l'historique Git de mailer.ts).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Adresse d'expedition unique (domaine verifie SPF/DKIM chez Brevo), toujours
# utilisee comme "sender" de l'API REST. Le nom affiche et le Reply-To sont,
# eux, ceux du cabinet (voir cabinetContact.ts).
SMTP_FROM_EMAIL=notifications@aurore-app.bj

# --- Auth (Phase 2) ---
# Chaine aleatoire d'au moins 16 caracteres, utilisee pour signer les sessions.
# Generer avec : openssl rand -hex 32
# Requis uniquement en DATABASE_MODE=externe/reseau. En DATABASE_MODE=portable
# (installeur desktop, Lot 8), laisser vide : un secret propre a chaque
# installation est genere automatiquement au premier lancement et stocke dans
# %APPDATA%/Aurore/secrets/session-secret.json - voir security/sessionSecretStore.ts.
SESSION_SECRET=

# --- Stockage documentaire par dossier / GED (Lot 15) ---
# Taille maximale (en Mo) d'une piece jointe uploadee sur un dossier. 20 par
# defaut - ajuster selon les besoins reels (scans multi-pages...). Voir
# README-LOT15.md.
DOCUMENTS_TAILLE_MAX_MO=20
