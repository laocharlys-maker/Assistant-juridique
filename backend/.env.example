# --- Base de donnees (Phase 0) ---
# URL de connexion vers le serveur PostgreSQL existant (VPS Hostinger) ou local.
# Ne jamais committer le fichier .env reel.
DATABASE_URL="postgresql://user:password@host:5432/aurore?schema=public"

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- IA (Phase 1+, pas necessaire pour demarrer la Phase 0) ---
# Fournisseur actif pour extraction/redaction/recherche : "gemini" ou "anthropic"
LLM_PROVIDER=gemini
# Gemini (gratuit, utilise pour le developpement) : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude (Anthropic, payant a l'usage) : rempli seulement si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Tavily : recherche web complementaire au RAG jurisprudence
TAVILY_API_KEY=
# Note : la transcription vocale WhatsApp reste geree par Gemini cote n8n,
# independamment de LLM_PROVIDER ci-dessus.

# --- Google Workspace OAuth (Phase 1+) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- WhatsApp / Evolution API (Phase 1+) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# --- n8n (Phase 1+, backend -> n8n pour les effets de bord) ---
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=

# --- Auth (Phase 2) ---
SESSION_SECRET=
