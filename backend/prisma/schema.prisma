generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  titulaire
  avocat
  collaborateur
}

enum Canal {
  web
  whatsapp
}

enum TypeAction {
  notes
  redac
  jurisprudence
  recherche_juridique
  conclusions
  assignation
  mise_en_demeure
  traduction
  resume_pdf
  veille_juridique
  plainte
  contrat
  notification_date
  requete
}

enum StatutExecution {
  succes
  erreur
}

enum StatutAction {
  brouillon
  en_attente_validation
  valide
  envoye
}

enum UniteDelai {
  jours
  mois
}

enum FactureStatut {
  brouillon
  envoyee
  payee
}

enum StatutRoleAudience {
  a_preparer
  pret
  traite
}

model Cabinet {
  id        String   @id @default(uuid())
  nom       String
  // Image d'en-tete (logo/bandeau) inseree en haut des documents, a la
  // demande (case a cocher), jamais automatiquement.
  enteteUrl String?  @map("entete_url")
  // Sujets/mots-cles a surveiller pour la veille juridique hebdomadaire,
  // saisis en texte libre par le titulaire (separes par virgule ou saut de
  // ligne).
  veilleSujets String? @map("veille_sujets")
  // La veille hebdomadaire n'est envoyee que si activee explicitement.
  veilleActive Boolean @default(false) @map("veille_active")
  // Delai (en mois) apres la cloture d'un dossier avant archivage
  // automatique. N'entraine jamais de suppression, juste un rangement hors
  // de la liste par defaut.
  archivageDelaiMois Int @default(6) @map("archivage_delai_mois")
  createdAt DateTime @default(now()) @map("created_at")

  users         User[]
  dossiers      Dossier[]
  clients       Client[]
  delaiTypes    DelaiType[]
  factures      Facture[]
  roleAudiences RoleAudience[]

  @@map("cabinets")
}

model User {
  id                    String   @id @default(uuid())
  cabinetId             String   @map("cabinet_id")
  nom                   String
  email                 String   @unique
  motDePasseHash        String   @map("mot_de_passe_hash")
  role                  UserRole @default(collaborateur)
  // Avocat dont depend directement ce collaborateur (null pour un titulaire).
  responsableId         String?  @map("responsable_id")
  // Chemin public de l'image de signature (ex: /uploads/signatures/xxx.png).
  signatureUrl          String?  @map("signature_url")
  // Un collaborateur peut, si son avocat responsable l'autorise, inserer
  // la signature de ce dernier lors de l'envoi d'un document.
  partageSignatureActif Boolean  @default(false) @map("partage_signature_actif")
  // Accorde par l'admin a un collaborateur : accede a TOUS les dossiers
  // du cabinet, pas seulement ceux de son responsable / des acces accordes.
  accesTousDossiers     Boolean  @default(false) @map("acces_tous_dossiers")
  // Un avocat/titulaire peut se desinscrire de la veille juridique
  // hebdomadaire par email (sans effet pour un collaborateur).
  recoitVeille          Boolean  @default(true) @map("recoit_veille")
  // Compte desactive par l'admin : bloque la connexion et invalide toute
  // session en cours, sans supprimer l'historique (dossiers/actions crees
  // par cette personne restent intacts).
  actif                 Boolean  @default(true)
  telephone             String?
  adresse               String?
  // Date d'arrivee au cabinet (peut differer de createdAt, saisie a la main
  // - utile pour quelqu'un qui a rejoint le cabinet avant l'existence du
  // compte Aurore).
  dateArrivee           DateTime? @map("date_arrivee")
  createdAt             DateTime @default(now()) @map("created_at")

  cabinet           Cabinet       @relation(fields: [cabinetId], references: [id])
  responsable       User?         @relation("ResponsableCollaborateurs", fields: [responsableId], references: [id])
  collaborateurs    User[]        @relation("ResponsableCollaborateurs")
  dossiersCrees     Dossier[]     @relation("DossierCreatedBy")
  actionsCreees     Action[]      @relation("ActionCreatedBy")
  delaiTypesCrees   DelaiType[]
  delaiCalculsCrees DelaiCalcul[]
  facturesCreees    Facture[]     @relation("FactureCreatedBy")
  roleAudiencesCreees RoleAudience[] @relation("RoleAudienceCreatedBy")

  // Acces supplementaires accordes a CE collaborateur vers d'autres avocats.
  accesAccordes AccesSupplementaire[] @relation("AccesCollaborateur")
  // Acces que CET avocat a accordes a des collaborateurs (aux siens).
  accesOctroyes AccesSupplementaire[] @relation("AccesAvocat")

  @@map("users")
}

model AccesSupplementaire {
  id              String   @id @default(uuid())
  collaborateurId String   @map("collaborateur_id")
  avocatId        String   @map("avocat_id")
  createdAt       DateTime @default(now()) @map("created_at")

  collaborateur User @relation("AccesCollaborateur", fields: [collaborateurId], references: [id])
  avocat        User @relation("AccesAvocat", fields: [avocatId], references: [id])

  @@unique([collaborateurId, avocatId])
  @@map("acces_supplementaires")
}

model Client {
  id        String   @id @default(uuid())
  cabinetId String   @map("cabinet_id")
  nom       String
  email     String?
  telephone String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  // Fiche d'identite detaillee - tous facultatifs, saisis au fil de l'eau
  // selon ce que le cabinet sait deja du client.
  dateNaissance          DateTime? @map("date_naissance")
  lieuNaissance          String?   @map("lieu_naissance")
  quartierResidence      String?   @map("quartier_residence")
  rue                    String?
  autrePrecision         String?   @map("autre_precision")
  maison                 String?
  situationMatrimoniale  String?   @map("situation_matrimoniale")
  fonction               String?
  entreprise             String?
  adresseEntreprise      String?   @map("adresse_entreprise")

  cabinet  Cabinet   @relation(fields: [cabinetId], references: [id])
  dossiers Dossier[]

  @@map("clients")
}

// Referentiel des delais de procedure, saisi et valide par le cabinet
// (jamais devine par l'IA : erreur de delai = dossier perdu).
model DelaiType {
  id                    String     @id @default(uuid())
  cabinetId             String     @map("cabinet_id")
  nom                   String
  nombreUnites          Int        @map("nombre_unites")
  unite                 UniteDelai
  joursOuvresUniquement Boolean    @default(true) @map("jours_ouvres_uniquement")
  texteReference        String     @map("texte_reference")
  actif                 Boolean    @default(true)
  createdById           String     @map("created_by_id")
  createdAt             DateTime   @default(now()) @map("created_at")

  cabinet   Cabinet       @relation(fields: [cabinetId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  calculs   DelaiCalcul[]

  @@map("delai_types")
}

model DelaiCalcul {
  id             String   @id @default(uuid())
  delaiTypeId    String   @map("delai_type_id")
  dossierId      String?  @map("dossier_id")
  dateDepart     DateTime @map("date_depart")
  dateLimite     DateTime @map("date_limite")
  rappelCalendar Boolean  @default(false) @map("rappel_calendar")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  delaiType DelaiType @relation(fields: [delaiTypeId], references: [id])
  dossier   Dossier?  @relation(fields: [dossierId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@map("delai_calculs")
}

model Dossier {
  id            String   @id @default(uuid())
  cabinetId     String   @map("cabinet_id")
  clientId      String?  @map("client_id")
  numeroDossier String   @map("numero_dossier")
  nomAffaire    String   @map("nom_affaire")
  nomClient     String   @map("nom_client")
  nomJuridiction String? @map("nom_juridiction")
  nomChambre    String?  @map("nom_chambre")
  createdBy     String   @map("created_by")
  statut        String   @default("actif")
  // true pour les fiches creees par une recherche (jurisprudence /
  // recherche juridique) : ce ne sont pas de vrais dossiers clients.
  estRecherche  Boolean  @default(false) @map("est_recherche")
  // Date de passage a "cloture" - sert de point de depart au delai
  // d'archivage automatique. Remise a null si le dossier est rouvert.
  dateCloture   DateTime? @map("date_cloture")
  // Rempli automatiquement une fois le delai d'archivage ecoule depuis
  // dateCloture. N'entraine jamais de suppression : juste masque de la
  // liste "Dossiers" par defaut, toujours consultable via "Archives".
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cabinet       Cabinet        @relation(fields: [cabinetId], references: [id])
  client        Client?        @relation(fields: [clientId], references: [id])
  creePar       User           @relation("DossierCreatedBy", fields: [createdBy], references: [id])
  actions       Action[]
  delaiCalculs  DelaiCalcul[]
  factures      Facture[]
  roleAudiences RoleAudience[]

  @@unique([cabinetId, numeroDossier])
  @@map("dossiers")
}

// Role de la semaine : audiences a venir (une par ligne), saisies
// manuellement par le cabinet a partir du role recu du greffe/tribunal
// (document externe, format non standardise - jamais extrait
// automatiquement). Publie generalement ~10 jours avant la semaine
// concernee, d'ou l'interet d'avoir une vue dediee pour preparer a temps.
model RoleAudience {
  id                 String             @id @default(uuid())
  cabinetId          String             @map("cabinet_id")
  dossierId          String?            @map("dossier_id")
  dateAudience       DateTime           @map("date_audience")
  juridiction        String
  chambre            String?
  procedureNumero    String?            @map("procedure_numero")
  // Libelle des parties tel que sur le role (ex: "Koffi C/ Kodjo").
  parties            String
  qualiteProcedurale String?            @map("qualite_procedurale")
  objetProcedure     String?            @map("objet_procedure")
  dernierMotif       String?            @map("dernier_motif")
  diligences         String?
  statut             StatutRoleAudience @default(a_preparer)
  createdBy          String             @map("created_by")
  createdAt          DateTime           @default(now()) @map("created_at")

  cabinet Cabinet  @relation(fields: [cabinetId], references: [id])
  dossier Dossier? @relation(fields: [dossierId], references: [id])
  creePar User     @relation("RoleAudienceCreatedBy", fields: [createdBy], references: [id])

  @@map("role_audiences")
}

// Suivi interne des honoraires/paiements. Ce n'est PAS une facture
// normalisee au sens fiscal beninois (SYGMEF) : la facture officielle
// reste emise separement par l'avocat sur son propre compte SYGMEF. Ce
// document sert au cabinet pour le suivi (montant, statut, envoi client).
model Facture {
  id          String  @id @default(uuid())
  cabinetId   String  @map("cabinet_id")
  // Optionnel : une facture (notamment une proforma) peut concerner un
  // client sans dossier encore ouvert.
  dossierId   String? @map("dossier_id")
  // Nom du client tel que saisi/choisi au moment de la facture - independant
  // du dossier, pour couvrir le cas d'un prospect pas encore en base.
  clientNom   String  @map("client_nom")
  numero      String
  description String
  // Montant Hors Taxes en Francs CFA.
  montant           Int
  appliquerTva      Boolean       @default(false) @map("appliquer_tva")
  estProforma       Boolean       @default(false) @map("est_proforma")
  dateEmission      DateTime      @default(now()) @map("date_emission")
  dateEcheance      DateTime?     @map("date_echeance")
  statut            FactureStatut @default(brouillon)
  destinataireEmail String?       @map("destinataire_email")
  envoyeAt          DateTime?     @map("envoye_at")
  payeeAt           DateTime?     @map("payee_at")
  createdBy         String        @map("created_by")
  createdAt         DateTime      @default(now()) @map("created_at")

  cabinet Cabinet  @relation(fields: [cabinetId], references: [id])
  dossier Dossier? @relation(fields: [dossierId], references: [id])
  creePar User     @relation("FactureCreatedBy", fields: [createdBy], references: [id])

  @@unique([cabinetId, numero])
  @@map("factures")
}

model Action {
  id                String       @id @default(uuid())
  dossierId         String       @map("dossier_id")
  typeAction        TypeAction   @map("type_action")
  canal             Canal
  contenuGenere     String?      @map("contenu_genere")
  dateAudience      DateTime?    @map("date_audience")
  prochaineAudience DateTime?    @map("prochaine_audience")
  piecesPrevoir     String?      @map("pieces_prevoir")
  // Statut de validation/envoi (remplace l'envoi automatique par mail).
  statut            StatutAction @default(brouillon)
  documentUrl       String?      @map("document_url")
  documentId        String?      @map("document_id")
  destinataireEmail String?      @map("destinataire_email")
  envoyeAt          DateTime?    @map("envoye_at")
  createdBy         String       @map("created_by")
  createdAt         DateTime     @default(now()) @map("created_at")

  dossier   Dossier    @relation(fields: [dossierId], references: [id])
  creePar   User       @relation("ActionCreatedBy", fields: [createdBy], references: [id])
  auditLogs AuditLog[]

  @@map("actions")
}

model AuditLog {
  id        String          @id @default(uuid())
  actionId  String          @map("action_id")
  etape     String
  statut    StatutExecution
  detail    String?
  timestamp DateTime        @default(now())

  action Action @relation(fields: [actionId], references: [id])

  @@map("audit_logs")
}

model JurisprudenceChunk {
  id           String                 @id @default(uuid())
  source       String
  reference    String
  juridiction  String?
  dateDecision String?                @map("date_decision")
  contenu      String
  embedding    Unsupported("vector")?
  createdAt    DateTime               @default(now()) @map("created_at")

  @@map("jurisprudence_chunks")
}
