generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgcrypto (Lot 2bis) : disponible sur l'instance pour un usage futur
  // eventuel (rotation de cle, primitives cryptographiques cote SQL) - le
  // chiffrement au repos des champs sensibles ci-dessous est fait cote
  // application (Node, AES-256-GCM) et non via pgcrypto. Voir
  // README-LOT2BIS.md pour le choix (a) vs (b).
  extensions = [vector, pgcrypto]
}

enum UserRole {
  titulaire
  avocat
  collaborateur
  // Compte plateforme (l'exploitant d'Aurore, pas un cabinet client) :
  // gere la liste des cabinets clients, leur acces et leurs modules actifs.
  // N'appartient a aucune donnee metier d'un cabinet - seul le role compte,
  // le cabinetId de ce compte n'est qu'un rattachement technique (voir
  // scripts/bootstrapSuperAdmin.ts).
  super_admin
}

enum Canal {
  web
  whatsapp
}

enum TypeAction {
  notes
  redac
  jurisprudence
  recherche_juridique
  conclusions
  assignation
  mise_en_demeure
  traduction
  resume_pdf
  veille_juridique
  plainte
  contrat
  notification_date
  requete
  projet_ordonnance
  note_plaidoirie
}

enum StatutExecution {
  succes
  erreur
}

enum StatutAction {
  brouillon
  en_attente_validation
  valide
  envoye
  // Lot 5 : echec fail-safe de la pseudonymisation (token orphelin detecte
  // apres reponse du LLM, ou toute anomalie equivalente) - jamais confondu
  // avec "brouillon", pour que le cabinet distingue clairement un document
  // qui n'a jamais ete genere avec succes. Voir README-LOT5.md.
  echec_generation
  // Lot 10 : un avocat/titulaire a laisse au moins une remarque de revision
  // (CommentaireRevision) sur un document en_attente_validation - retour a
  // en_attente_validation uniquement via l'action explicite "Renvoyer pour
  // validation", une fois toutes les remarques resolues. Voir README-LOT10.md.
  revision_demandee
}

enum UniteDelai {
  jours
  mois
}

enum FactureStatut {
  brouillon
  envoyee
  payee
}

enum StatutRoleAudience {
  a_preparer
  pret
  traite
}

// Lot 12a : type strict (pas de texte libre) pour permettre un filtrage
// fiable de la vue calendrier unifiee.
enum TypeEvenement {
  audience
  rdv
  appel
  tache
  echeance_procedure
  autre
}

// Lot 12a : origine de l'Evenement - "role_audience" et "delai_calcule"
// sont generes automatiquement par evenementSync.ts (jamais crees/modifies
// manuellement pour ces deux-la, voir README-LOT12A.md) ; "sync_google" et
// "sync_caldav" sont prevus des maintenant pour le Lot 12b (evite une
// migration supplementaire), pas encore utilises.
enum SourceEvenement {
  manuel
  role_audience
  delai_calcule
  sync_google
  sync_caldav
  // Lot 16 : cree a partir d'une date detectee dans le corps d'un email,
  // TOUJOURS apres confirmation/correction explicite de l'utilisateur dans
  // l'ecran "Boite de reception" - jamais automatique (voir README-LOT16.md).
  email
}

model Cabinet {
  id                                  String    @id @default(uuid())
  nom                                 String
  // Acces coupe par la plateforme (impaye, resiliation...) : bloque la
  // connexion de tous les utilisateurs du cabinet, sans supprimer aucune
  // donnee - reactivable a tout moment.
  actif                               Boolean   @default(true)
  // Modules payants desactives pour ce cabinet (cle libre, ex:
  // "facturation", "veille_juridique", "jurisprudence", "delais") - gere
  // par la plateforme selon la formule souscrite. Absent de la liste =
  // module actif.
  modulesDesactives                   String[]  @default([]) @map("modules_desactives")
  // Palier tarifaire assigne par la plateforme (ex: "1-10 utilisateurs",
  // "11-20 utilisateurs"...) - purement informatif, sert de repere pour la
  // facturation manuelle du cabinet, n'entraine aucun calcul automatique.
  plan                                String?   @map("plan")
  // Adresse postale du cabinet - utilisee notamment dans l'entete de
  // certains documents generes (ex: conclusions), saisie une fois pour
  // toutes plutot que redemandee a chaque document.
  adresse                             String?
  // Adresse de reponse (Reply-To) utilisee pour tous les emails envoyes
  // depuis Aurore au nom de ce cabinet (facture, document, veille...) -
  // permet aux destinataires de repondre directement au cabinet, meme si
  // l'envoi technique passe par une adresse plateforme partagee. Null =
  // repli automatique sur l'email du titulaire.
  emailContact                        String?   @map("email_contact")
  // Police et taille de texte utilisees dans les exports Word/PDF generes
  // par Aurore (pas les documents crees via Google Docs). Police limitee a
  // un choix ferme (Times New Roman / Arial / Courier New) pour rester
  // identique entre l'export Word (police libre) et l'export PDF (polices
  // standard PDFKit uniquement, sans police a embarquer).
  policeDocuments                     String    @default("Times New Roman") @map("police_documents")
  tailleDocuments                     Int       @default(13) @map("taille_documents")
  // Image d'en-tete (logo/bandeau) inseree en haut des documents, a la
  // demande (case a cocher), jamais automatiquement.
  enteteUrl                           String?   @map("entete_url")
  // Sujets/mots-cles a surveiller pour la veille juridique hebdomadaire,
  // saisis en texte libre par le titulaire (separes par virgule ou saut de
  // ligne).
  veilleSujets                        String?   @map("veille_sujets")
  // La veille hebdomadaire n'est envoyee que si activee explicitement.
  veilleActive                        Boolean   @default(false) @map("veille_active")
  // Delai (en mois) apres la cloture d'un dossier avant archivage
  // automatique. N'entraine jamais de suppression, juste un rangement hors
  // de la liste par defaut.
  archivageDelaiMois                  Int       @default(6) @map("archivage_delai_mois")
  // Nombre max de documents qu'un collaborateur peut generer par mois
  // calendaire (protection contre les abus/grosses factures IA). Null =
  // pas de limite. Ne s'applique jamais aux avocats/titulaire.
  limiteDocumentsCollaborateurParMois Int?      @map("limite_documents_collaborateur_par_mois")
  // Quota mensuel impose par la PLATEFORME (distinct du quota ci-dessus,
  // que le cabinet fixe lui-meme pour ses collaborateurs) : plafonne le
  // total de documents generes par TOUS les comptes du cabinet confondus,
  // selon la formule souscrite. Null = pas de plafond.
  limiteDocumentsCabinetParMois       Int?      @map("limite_documents_cabinet_par_mois")
  // Nombre max de comptes (tous roles confondus, titulaire inclus) que le
  // cabinet peut creer, impose par la plateforme selon la formule
  // souscrite. Null = pas de plafond.
  limiteComptes                       Int?      @map("limite_comptes")
  // Fin de la periode d'acces accordee par la plateforme (essai gratuit,
  // periode payee...). Null = acces permanent. Une fois cette date passee,
  // la connexion est bloquee comme une suspension, jusqu'a ce que la
  // plateforme fixe une nouvelle date future.
  essaiExpireLe                       DateTime? @map("essai_expire_le")
  // Lot 3 : miroir en base de la licence locale installee sur le poste de
  // ce cabinet (source de verite reelle = %APPDATA%/Aurore/licence.lic,
  // voir server/src/security/licenceManager.ts) - sert uniquement a la
  // visibilite admin/support, jamais a la decision d'acces elle-meme, qui
  // reste toujours evaluee localement a partir du fichier. licenceId est un
  // identifiant derive localement (pas un champ du fichier de licence
  // signe), empreinteMachineAutorisee est deja un hash SHA-256 (jamais
  // l'identifiant materiel brut).
  licenceId                           String?   @map("licence_id")
  licenceModeVerification             String?   @map("licence_mode_verification")
  licenceDateExpiration               DateTime? @map("licence_date_expiration")
  empreinteMachineAutorisee           String?   @map("empreinte_machine_autorisee")
  createdAt                           DateTime  @default(now()) @map("created_at")

  users         User[]
  dossiers      Dossier[]
  clients       Client[]
  delaiTypes    DelaiType[]
  factures      Facture[]
  roleAudiences RoleAudience[]
  huissiers     Huissier[]
  evenements    Evenement[]
  saisiesTemps  SaisieTemps[]
  documents     DocumentDossier[]

  @@map("cabinets")
}

// Annuaire des huissiers/commissaires de justice du cabinet, pour proposer
// un choix rapide lors de l'envoi d'une Assignation ou Mise en demeure
// (plutot que ressaisir l'adresse a chaque fois).
model Huissier {
  id        String   @id @default(uuid())
  cabinetId String   @map("cabinet_id")
  nom       String
  email     String
  telephone String?
  createdAt DateTime @default(now()) @map("created_at")

  cabinet Cabinet @relation(fields: [cabinetId], references: [id])

  @@index([cabinetId])
  @@map("huissiers")
}

model User {
  id                     String    @id @default(uuid())
  cabinetId              String    @map("cabinet_id")
  nom                    String
  email                  String    @unique
  motDePasseHash         String    @map("mot_de_passe_hash")
  role                   UserRole  @default(collaborateur)
  // Avocat dont depend directement ce collaborateur (null pour un titulaire).
  responsableId          String?   @map("responsable_id")
  // Chemin public de l'image de signature (ex: /uploads/signatures/xxx.png).
  signatureUrl           String?   @map("signature_url")
  // Un collaborateur peut, si son avocat responsable l'autorise, inserer
  // la signature de ce dernier lors de l'envoi d'un document.
  partageSignatureActif  Boolean   @default(false) @map("partage_signature_actif")
  // Accorde par l'admin a un collaborateur : accede a TOUS les dossiers
  // du cabinet, pas seulement ceux de son responsable / des acces accordes.
  accesTousDossiers      Boolean   @default(false) @map("acces_tous_dossiers")
  // Modules retires par le TITULAIRE pour CE collaborateur precis (memes
  // cles que Cabinet.modulesDesactives) - s'applique EN PLUS du reglage
  // plateforme, jamais au-dessus : un module deja desactive pour tout le
  // cabinet reste desactive quel que soit ce champ. Uniquement pertinent
  // pour role=collaborateur (voir routes/users.ts, PATCH .../modules) - un
  // avocat/titulaire garde toujours l'acces complet accorde par la
  // plateforme.
  modulesDesactives      String[]  @default([]) @map("modules_desactives")
  // Un avocat/titulaire peut se desinscrire de la veille juridique
  // hebdomadaire par email (sans effet pour un collaborateur).
  recoitVeille           Boolean   @default(true) @map("recoit_veille")
  // Compte desactive par l'admin : bloque la connexion et invalide toute
  // session en cours, sans supprimer l'historique (dossiers/actions crees
  // par cette personne restent intacts).
  actif                  Boolean   @default(true)
  // Horodatage de la derniere connexion reussie - utilise pour reperer les
  // cabinets/utilisateurs actifs depuis la page d'administration plateforme.
  lastLoginAt            DateTime? @map("last_login_at")
  // Quota mensuel impose par la PLATEFORME sur CE compte precis, tous roles
  // confondus (distinct du quota "collaborateurs" fixe par le cabinet
  // lui-meme). Null = pas de plafond individuel.
  limiteDocumentsParMois Int?      @map("limite_documents_par_mois")
  telephone              String?
  adresse                String?
  // Date d'arrivee au cabinet (peut differer de createdAt, saisie a la main
  // - utile pour quelqu'un qui a rejoint le cabinet avant l'existence du
  // compte Aurore).
  dateArrivee            DateTime? @map("date_arrivee")
  // Lot 14 : taux horaire en FCFA, INDIVIDUEL (pas un taux unique par
  // cabinet - un avocat senior facture plus qu'un collaborateur junior,
  // voir README-LOT14.md). Snapshotte dans SaisieTemps.tauxHoraireApplique
  // au moment de chaque saisie : le modifier ici n'affecte jamais
  // retroactivement une saisie deja enregistree. Null = pas encore
  // configure (une saisie sans taux n'est pas valorisable, voir
  // services/feuillesTemps.ts).
  tauxHoraireDefaut      Int?      @map("taux_horaire_defaut")
  createdAt              DateTime  @default(now()) @map("created_at")

  cabinet             Cabinet        @relation(fields: [cabinetId], references: [id])
  responsable         User?          @relation("ResponsableCollaborateurs", fields: [responsableId], references: [id])
  collaborateurs      User[]         @relation("ResponsableCollaborateurs")
  dossiersCrees       Dossier[]      @relation("DossierCreatedBy")
  actionsCreees       Action[]       @relation("ActionCreatedBy")
  delaiTypesCrees     DelaiType[]
  delaiCalculsCrees   DelaiCalcul[]
  facturesCreees      Facture[]      @relation("FactureCreatedBy")
  roleAudiencesCreees RoleAudience[] @relation("RoleAudienceCreatedBy")

  // Acces supplementaires accordes a CE collaborateur vers d'autres avocats.
  accesAccordes AccesSupplementaire[] @relation("AccesCollaborateur")
  // Acces que CET avocat a accordes a des collaborateurs (aux siens).
  accesOctroyes AccesSupplementaire[] @relation("AccesAvocat")

  // Lot 10 : remarques de revision redigees par CET avocat/titulaire, et
  // celles que CET utilisateur a marquees resolues (peut differer de
  // l'auteur - voir README-LOT10.md).
  commentairesRevisionEcrits  CommentaireRevision[] @relation("CommentaireRevisionAuteur")
  commentairesRevisionResolus CommentaireRevision[] @relation("CommentaireRevisionResoluPar")

  // Lot 11 (Partie A) : documents actuellement verrouilles par CET
  // utilisateur (edition en cours), et versions qu'il/elle a enregistrees.
  actionsVerrouillees Action[]        @relation("ActionVerrouillePar")
  versionsRedigees    ActionVersion[] @relation("ActionVersionAuteur")

  // Lot 12a : evenements crees par CET utilisateur, et ceux auxquels
  // il/elle est assigne(e) (table de liaison EvenementAssigne).
  evenementsCrees    Evenement[]        @relation("EvenementCreatedBy")
  evenementsAssignes EvenementAssigne[]

  // Lot 12b : agendas externes connectes par CET utilisateur (OAuth2
  // individuel - jamais un compte cabinet partage).
  connexionsCalendrierExterne ConnexionCalendrierExterne[]

  // Lot 14 : temps enregistre par CET utilisateur (chronometre ou saisie
  // manuelle).
  saisiesTemps SaisieTemps[]

  // Lot 15 : pieces uploadees par CET utilisateur.
  documentsUploades DocumentDossier[]

  // Lot 16 : boites mail connectees par CET utilisateur (OAuth2 Gmail
  // individuel, ou identifiants IMAP - jamais un compte cabinet partage).
  connexionsEmailExterne ConnexionEmailExterne[]

  // Factures pour lesquelles CET utilisateur a explicitement demande a ne
  // plus recevoir le rappel de paiement (pop-up du tableau de bord).
  facturesRappelsIgnores FactureRappelIgnore[]

  @@index([cabinetId])
  @@map("users")
}

model AccesSupplementaire {
  id              String   @id @default(uuid())
  collaborateurId String   @map("collaborateur_id")
  avocatId        String   @map("avocat_id")
  createdAt       DateTime @default(now()) @map("created_at")

  collaborateur User @relation("AccesCollaborateur", fields: [collaborateurId], references: [id])
  avocat        User @relation("AccesAvocat", fields: [avocatId], references: [id])

  @@unique([collaborateurId, avocatId])
  @@map("acces_supplementaires")
}

// Champs marques [chiffre-au-repos] : chiffres/dechiffres de facon
// transparente par l'extension Prisma security/prismaEncryption.ts (Lot
// 2bis, AES-256-GCM cote application) - stockage inchange (String/Json?),
// jamais utilises dans un WHERE ou un ORDER BY cote SQL. Voir
// README-LOT2BIS.md.
model Client {
  id        String   @id @default(uuid())
  cabinetId String   @map("cabinet_id")
  nom       String // [chiffre-au-repos]
  email     String? // [chiffre-au-repos]
  telephone String? // [chiffre-au-repos]
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  // Personne physique ou morale (entreprise) - determine quels champs de la
  // fiche s'appliquent (une entreprise n'a pas de date de naissance, de
  // profession, etc.). "physique" par defaut pour les fiches existantes.
  typePersonne String  @default("physique") @map("type_personne")
  // Civilite (M./Mme/Mlle) - ne s'applique qu'aux personnes physiques,
  // utilisee notamment dans les actes generes (assignation, conclusions...).
  civilite     String?

  // Fiche d'identite detaillee - tous facultatifs, saisis au fil de l'eau
  // selon ce que le cabinet sait deja du client.
  dateNaissance         DateTime? @map("date_naissance")
  lieuNaissance         String?   @map("lieu_naissance")
  // Numero de piece d'identite (CNI, passeport...) - utilise notamment dans
  // les actes d'huissier (assignation) qui doivent identifier precisement
  // le demandeur.
  numeroPieceIdentite   String?   @map("numero_piece_identite") // [chiffre-au-repos]
  quartierResidence     String?   @map("quartier_residence") // [chiffre-au-repos]
  rue                   String? // [chiffre-au-repos]
  autrePrecision        String?   @map("autre_precision") // [chiffre-au-repos]
  maison                String? // [chiffre-au-repos]
  situationMatrimoniale String?   @map("situation_matrimoniale")
  fonction              String?
  entreprise            String?
  adresseEntreprise     String?   @map("adresse_entreprise")

  cabinet  Cabinet   @relation(fields: [cabinetId], references: [id])
  dossiers Dossier[]

  @@index([cabinetId])
  @@map("clients")
}

// Referentiel des delais de procedure, saisi et valide par le cabinet
// (jamais devine par l'IA : erreur de delai = dossier perdu).
model DelaiType {
  id                    String     @id @default(uuid())
  cabinetId             String     @map("cabinet_id")
  nom                   String
  nombreUnites          Int        @map("nombre_unites")
  unite                 UniteDelai
  joursOuvresUniquement Boolean    @default(true) @map("jours_ouvres_uniquement")
  texteReference        String     @map("texte_reference")
  actif                 Boolean    @default(true)
  createdById           String     @map("created_by_id")
  createdAt             DateTime   @default(now()) @map("created_at")

  cabinet   Cabinet       @relation(fields: [cabinetId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  calculs   DelaiCalcul[]

  @@index([cabinetId])
  @@map("delai_types")
}

model DelaiCalcul {
  id             String   @id @default(uuid())
  delaiTypeId    String   @map("delai_type_id")
  dossierId      String?  @map("dossier_id")
  dateDepart     DateTime @map("date_depart")
  dateLimite     DateTime @map("date_limite")
  // Orpheline (Lot 8ter) : le rappel Google Calendar qui l'alimentait est
  // retire du produit (remplace par la page "Echeances", deja presente dans
  // l'app) - toujours false desormais. Conservee sans migration de
  // suppression, non necessaire (voir README-LOT8TER.md).
  rappelCalendar Boolean  @default(false) @map("rappel_calendar")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  delaiType DelaiType @relation(fields: [delaiTypeId], references: [id])
  dossier   Dossier?  @relation(fields: [dossierId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])
  // Lot 12a : voir RoleAudience.evenement ci-dessus, meme raisonnement.
  evenement Evenement?

  @@index([dossierId])
  @@map("delai_calculs")
}

model Dossier {
  id             String    @id @default(uuid())
  cabinetId      String    @map("cabinet_id")
  clientId       String?   @map("client_id")
  numeroDossier  String    @map("numero_dossier")
  nomAffaire     String    @map("nom_affaire")
  nomClient      String    @map("nom_client")
  nomJuridiction String?   @map("nom_juridiction")
  nomChambre     String?   @map("nom_chambre")
  createdBy      String    @map("created_by")
  statut         String    @default("actif")
  // true pour les fiches creees par une recherche (jurisprudence /
  // recherche juridique) : ce ne sont pas de vrais dossiers clients.
  estRecherche   Boolean   @default(false) @map("est_recherche")
  // Date de passage a "cloture" - sert de point de depart au delai
  // d'archivage automatique. Remise a null si le dossier est rouvert.
  dateCloture    DateTime? @map("date_cloture")
  // Rempli automatiquement une fois le delai d'archivage ecoule depuis
  // dateCloture. N'entraine jamais de suppression : juste masque de la
  // liste "Dossiers" par defaut, toujours consultable via "Archives".
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  cabinet       Cabinet        @relation(fields: [cabinetId], references: [id])
  client        Client?        @relation(fields: [clientId], references: [id])
  creePar       User           @relation("DossierCreatedBy", fields: [createdBy], references: [id])
  actions       Action[]
  delaiCalculs  DelaiCalcul[]
  factures      Facture[]
  roleAudiences RoleAudience[]
  evenements    Evenement[]
  saisiesTemps  SaisieTemps[]
  documents     DocumentDossier[]

  @@unique([cabinetId, numeroDossier])
  @@index([clientId])
  @@index([archivedAt])
  @@map("dossiers")
}

// Lot 15 : piece stockee et rattachee a un dossier (contrat scanne,
// correspondance, preuve, piece d'identite...) - independant de tout acte
// genere par Aurore (Action.contenuGenere). Le fichier lui-meme vit sur
// disque, chiffre (voir services/stockageDocuments.ts) : cette table ne
// contient JAMAIS le contenu binaire, uniquement des metadonnees et le nom
// du fichier chiffre sur disque.
model DocumentDossier {
  id           String  @id @default(uuid())
  cabinetId    String  @map("cabinet_id")
  dossierId    String  @map("dossier_id")
  // Nom d'origine tel qu'uploade (metadonnee d'affichage uniquement) -
  // jamais utilise pour nommer le fichier sur disque (voir nomFichier).
  nomOriginal  String  @map("nom_original")
  typeMime     String  @map("type_mime")
  tailleOctets Int     @map("taille_octets")
  // Nom du fichier CHIFFRE sur disque, dans le dossier de ce DocumentDossier
  // (voir stockageDocuments.ts, dossierDocumentsDir(dossierId)) - un UUID
  // genere a l'upload, jamais previsible/le nom d'origine (evite collisions
  // et fuite d'information via le nom de fichier - contrainte du prompt).
  nomFichier   String  @map("nom_fichier")
  // "upload" (saisie manuelle, Lot 15) ou "email" (import assiste depuis
  // une boite mail connectee, Lot 16 - emailOrigineId alors renseigne).
  source         String  @default("upload")
  // Lot 16 : lien reel vers l'email source, ajoute maintenant que
  // EmailImporte existe (prevu nullable des le Lot 15, sans dependance
  // creee a l'epoque - voir README-LOT15.md et README-LOT16.md). SetNull
  // (pas Cascade) : la suppression d'un EmailImporte (ex: purge future) ne
  // doit jamais entrainer la suppression d'une piece deja importee.
  emailOrigineId String? @map("email_origine_id")
  uploadeParId   String  @map("uploade_par_id")
  createdAt      DateTime @default(now()) @map("created_at")

  cabinet      Cabinet       @relation(fields: [cabinetId], references: [id])
  dossier      Dossier       @relation(fields: [dossierId], references: [id])
  uploadePar   User          @relation(fields: [uploadeParId], references: [id])
  emailOrigine EmailImporte? @relation(fields: [emailOrigineId], references: [id], onDelete: SetNull)
  ocrResultat  OcrResultat?

  @@index([dossierId])
  @@index([cabinetId])
  @@map("documents_dossier")
}

// Lot 17 : resultat OCR (reconnaissance optique de caracteres) d'une piece
// de dossier (DocumentDossier) - relation 1-1, cree "en_attente" des la
// mise en file (voir jobs/traitementOcr.ts), jamais avant. Ce lot ne fait
// JAMAIS transiter texteExtrait vers un LLM ni un service externe (voir
// README-LOT17.md) : contrairement a Action.champsDocument (Lot 5), un
// texte OCR est du texte libre non structure, sans garantie de
// pseudonymisation fiable - meme logique de prudence que le corps des
// emails au Lot 16.
enum OcrStatut {
  en_attente
  en_cours
  termine
  echec
}

model OcrResultat {
  id         String    @id @default(uuid())
  // documentId unique => relation 1-1 stricte avec DocumentDossier. Cascade :
  // la suppression d'une piece (Lot 15, DELETE /api/documents/:id) supprime
  // son resultat OCR - un OcrResultat ne doit jamais survivre a la piece
  // qu'il decrit.
  documentId String    @unique @map("document_id")
  // Denormalise depuis DocumentDossier (meme raisonnement que
  // documents_dossier.cabinet_id/dossier_id : evite un join pour les
  // controles d'acces et la recherche plein texte par dossier, voir
  // routes/ocr.ts).
  cabinetId  String    @map("cabinet_id")
  dossierId  String    @map("dossier_id")
  statut     OcrStatut @default(en_attente)
  // Moteur ayant produit ce resultat - une seule valeur possible en V1
  // ("tesseract"), mais colonne prevue des maintenant pour ne pas avoir a
  // migrer si une V2 opt-in cloud (voir README-LOT17.md) est ajoutee un jour.
  moteur         String   @default("tesseract")
  // Chiffre au repos (AES-256-GCM, security/encryptionAtRest.ts - Lot 2bis,
  // meme cle applicative que le reste du projet) - JAMAIS stocke en clair.
  // Voir encryptField/decryptField, format "enc:v1:...".
  texteExtrait   String?  @map("texte_extrait")
  // 0-100, moyenne ponderee des scores de confiance Tesseract par page/mot
  // (voir services/ocr/moteurTesseract.ts) - jamais laisse a null si
  // statut = termine.
  scoreConfiance Float?   @map("score_confiance")
  // Message clair, jamais un stacktrace brut (voir services/ocr/moteurTesseract.ts).
  messageErreur  String?  @map("message_erreur")
  tentatives     Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  document DocumentDossier @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@index([cabinetId])
  @@index([statut])
  @@map("ocr_resultats")
}

// Lot 16 : mailbox connectee par un utilisateur (OAuth2 Gmail individuel,
// ou identifiants IMAP generiques pour les autres fournisseurs) - jamais un
// compte cabinet partage, meme principe que ConnexionCalendrierExterne
// (Lot 12b), delibrement SEPAREE de celle-ci (scopes OAuth differents,
// couplage juge non souhaitable pour cette V1 - voir README-LOT16.md).
enum ProviderEmailExterne {
  gmail
  imap
}

enum StatutEmailImporte {
  nouveau
  traite
}

model ConnexionEmailExterne {
  id       String               @id @default(uuid())
  userId   String               @map("user_id")
  provider ProviderEmailExterne

  // --- Gmail (OAuth2) --- [chiffre-au-repos pour access_token/refresh_token]
  accessToken    String?   @map("access_token")
  refreshToken   String?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at")
  // Adresse Gmail connectee (affichage uniquement, ex. "Connecte : x@gmail.com").
  adresseEmail   String?   @map("adresse_email")

  // --- IMAP generique --- [chiffre-au-repos pour imap_password]
  imapHost     String?  @map("imap_host")
  imapPort     Int?     @map("imap_port")
  imapSecure   Boolean  @default(true) @map("imap_secure")
  imapUsername String?  @map("imap_username")
  imapPassword String?  @map("imap_password")

  // Curseur de polling : dernier identifiant de message deja recupere
  // (Gmail messageId le plus recent, ou UID IMAP le plus eleve) - evite de
  // re-lister les emails deja vus a chaque cycle node-cron.
  dernierIdentifiantSynchronise String? @map("dernier_identifiant_synchronise")

  actif          Boolean  @default(true)
  derniereErreur String?  @map("derniere_erreur")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user   User           @relation(fields: [userId], references: [id])
  emails EmailImporte[]

  @@unique([userId, provider])
  @@map("connexions_email_externe")
}

// Metadonnees d'un email recupere par polling - JAMAIS le corps complet du
// texte (voir dateDetecteeContexte ci-dessous : un court extrait autour de
// la date detectee uniquement, pas le message entier - contrainte du
// prompt "ne jamais logger le contenu complet d'un email"). Les pieces
// jointes ne sont PAS telechargees/stockees au moment du polling : seule
// leur metadonnee (nom, type, taille, identifiant cote fournisseur) est
// conservee ici ; le contenu binaire n'est recupere qu'a la confirmation
// explicite d'import (voir routes/emailIngestion.ts), jamais avant.
model EmailImporte {
  id                 String   @id @default(uuid())
  connexionId        String   @map("connexion_id")
  cabinetId          String   @map("cabinet_id")
  // Identifiant du message cote fournisseur (Gmail messageId, ou UID IMAP) -
  // garantit qu'un meme email n'est jamais liste deux fois.
  identifiantExterne String   @map("identifiant_externe")
  expediteurEmail    String   @map("expediteur_email")
  expediteurNom      String?  @map("expediteur_nom")
  objet              String?
  dateReception      DateTime @map("date_reception")
  // Metadonnees des pieces jointes detectees : [{ id, nomFichier, typeMime,
  // tailleOctets }] - "id" est l'identifiant cote fournisseur (attachmentId
  // Gmail, ou index de partie IMAP), utilise pour re-recuperer le contenu
  // binaire uniquement au moment de la confirmation d'import.
  piecesJointes      Json?    @map("pieces_jointes")
  // Date/heure detectee localement dans le corps (voir detectionDate.ts) -
  // proposee a l'utilisateur, jamais utilisee seule pour creer un Evenement.
  dateDetectee          DateTime? @map("date_detectee")
  // Court extrait de contexte autour de la date detectee (ex: "...le 12 a
  // 10h au tribunal...", quelques dizaines de caracteres) - PAS le corps
  // complet du message, uniquement pour que l'utilisateur comprenne d'ou
  // vient la suggestion avant de confirmer.
  dateDetecteeContexte  String?   @map("date_detectee_contexte")
  statut             StatutEmailImporte @default(nouveau)
  createdAt          DateTime           @default(now()) @map("created_at")

  connexion ConnexionEmailExterne @relation(fields: [connexionId], references: [id], onDelete: Cascade)
  documentsImportes DocumentDossier[]

  @@unique([connexionId, identifiantExterne])
  @@index([cabinetId])
  @@map("emails_importes")
}

// Role de la semaine : audiences a venir (une par ligne), saisies
// manuellement par le cabinet a partir du role recu du greffe/tribunal
// (document externe, format non standardise - jamais extrait
// automatiquement). Publie generalement ~10 jours avant la semaine
// concernee, d'ou l'interet d'avoir une vue dediee pour preparer a temps.
model RoleAudience {
  id                 String             @id @default(uuid())
  cabinetId          String             @map("cabinet_id")
  dossierId          String?            @map("dossier_id")
  dateAudience       DateTime           @map("date_audience")
  juridiction        String
  chambre            String?
  procedureNumero    String?            @map("procedure_numero")
  // Libelle des parties tel que sur le role (ex: "Koffi C/ Kodjo").
  parties            String
  qualiteProcedurale String?            @map("qualite_procedurale")
  objetProcedure     String?            @map("objet_procedure")
  dernierMotif       String?            @map("dernier_motif")
  diligences         String?
  statut             StatutRoleAudience @default(a_preparer)
  createdBy          String             @map("created_by")
  createdAt          DateTime           @default(now()) @map("created_at")

  cabinet Cabinet  @relation(fields: [cabinetId], references: [id])
  dossier Dossier? @relation(fields: [dossierId], references: [id])
  creePar User     @relation("RoleAudienceCreatedBy", fields: [createdBy], references: [id])
  // Lot 12a : Evenement genere automatiquement par evenementSync.ts -
  // optionnel car cree apres coup (hook additif, jamais dans la meme
  // transaction que la creation du RoleAudience).
  evenement Evenement?

  @@index([cabinetId])
  @@index([dossierId])
  @@map("role_audiences")
}

// Lot 12a : vue calendrier unifiee - couvre les audiences (generees depuis
// RoleAudience), les echeances de procedure (generees depuis DelaiCalcul) et
// les evenements crees manuellement (RDV, appel, tache, autre). Les deux
// premiers types ne sont jamais crees/modifies directement via
// POST/PATCH /api/evenements (voir routes/evenements.ts) - uniquement via
// leur enregistrement source, pour ne jamais diverger silencieusement de
// lui. Voir README-LOT12A.md pour la strategie de synchronisation douce.
model Evenement {
  id             String           @id @default(uuid())
  cabinetId      String           @map("cabinet_id")
  dossierId      String?          @map("dossier_id")
  type           TypeEvenement
  source         SourceEvenement  @default(manuel)
  titre          String
  description    String?
  dateDebut      DateTime         @map("date_debut")
  dateFin        DateTime?        @map("date_fin")
  touteLaJournee Boolean          @default(false) @map("toute_la_journee")
  lieu           String?
  createdById    String           @map("created_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  // Lien vers l'enregistrement source pour les Evenement auto-generes (au
  // plus un Evenement par RoleAudience/DelaiCalcul - upsert par ce champ
  // dans evenementSync.ts). Null pour un Evenement manuel.
  roleAudienceId String?          @unique @map("role_audience_id")
  delaiCalculId  String?          @unique @map("delai_calcul_id")

  cabinet       Cabinet                @relation(fields: [cabinetId], references: [id])
  dossier       Dossier?               @relation(fields: [dossierId], references: [id])
  createdBy     User                   @relation("EvenementCreatedBy", fields: [createdById], references: [id])
  roleAudience  RoleAudience?          @relation(fields: [roleAudienceId], references: [id], onDelete: SetNull)
  delaiCalcul   DelaiCalcul?           @relation(fields: [delaiCalculId], references: [id], onDelete: SetNull)
  assignes      EvenementAssigne[]
  // Lot 12b : etat de synchronisation vers chaque agenda externe concerne
  // (un Evenement peut se synchroniser vers plusieurs connexions - ex: le
  // createur ET un assigne ont chacun leur propre Google Calendar connecte).
  syncsExternes EvenementSyncExterne[]

  @@index([cabinetId, dateDebut])
  @@index([dossierId])
  @@map("evenements")
}

// Table de liaison many-to-many Evenement <-> User (collaborateurs
// assignes) - modele explicite plutot qu'une relation many-to-many
// implicite, pour rester requetable directement (filtre "par collaborateur"
// de la vue calendrier).
model EvenementAssigne {
  evenementId String @map("evenement_id")
  userId      String @map("user_id")

  evenement Evenement @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@id([evenementId, userId])
  @@map("evenement_assignes")
}

// Lot 12b : fournisseur d'agenda externe connecte par un utilisateur -
// OAuth2 individuel pour Google, identifiants CalDAV generiques pour les
// autres (Outlook.com, Proton Calendar, iCloud...). Jamais un compte
// cabinet partage : chaque ligne appartient a UN userId.
enum ProviderCalendrierExterne {
  google
  caldav
}

// Etat de synchronisation d'un Evenement particulier vers un agenda
// externe particulier - la "file d'attente" de la synchronisation
// asynchrone est realisee par ce tableau (lignes "en_attente"/"a_supprimer"
// = travail a faire), traite par le job planifie de services/calendrierSync/syncQueue.ts.
// Voir README-LOT12B.md pour la justification de ce choix (table durable
// plutot qu'une queue en memoire, qui perdrait son contenu a chaque
// redemarrage du serveur).
enum StatutSyncExterne {
  en_attente
  synchronise
  erreur
  a_supprimer
}

model ConnexionCalendrierExterne {
  id       String                    @id @default(uuid())
  userId   String                    @map("user_id")
  provider ProviderCalendrierExterne

  // --- Google (OAuth2) --- [chiffre-au-repos pour access_token/refresh_token]
  accessToken    String?   @map("access_token")
  refreshToken   String?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at")

  // --- CalDAV (identifiants generiques) --- [chiffre-au-repos pour caldav_password]
  caldavUrl      String? @map("caldav_url")
  caldavUsername String? @map("caldav_username")
  caldavPassword String? @map("caldav_password")

  // URL du calendrier cible decouverte a la connexion : le calendrier
  // principal CalDAV (reponse de la decouverte PROPFIND), ou "primary" pour
  // Google (toujours le calendrier principal du compte connecte en V1).
  calendrierUrl String? @map("calendrier_url")

  // Coupe la synchro FUTURE sans jamais rien supprimer (ni cote Aurore, ni
  // retroactivement cote externe) - voir DELETE /api/calendrier-externe/:id.
  actif          Boolean  @default(true)
  derniereErreur String?  @map("derniere_erreur")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user  User                   @relation(fields: [userId], references: [id])
  syncs EvenementSyncExterne[]

  // Un seul compte Google + un seul CalDAV par utilisateur en V1 (pas de
  // multi-comptes du meme fournisseur).
  @@unique([userId, provider])
  @@map("connexions_calendrier_externe")
}

model EvenementSyncExterne {
  id     String @id @default(uuid())
  // Nullable + SetNull (pas Cascade) : quand l'Evenement Aurore est
  // supprime, cette ligne doit SURVIVRE le temps que le job de synchro
  // supprime aussi l'evenement cote externe (statut "a_supprimer") - voir
  // evenementSync.ts et README-LOT12B.md.
  evenementId String? @map("evenement_id")
  connexionId String  @map("connexion_id")

  externalEventId String?           @map("external_event_id")
  statut          StatutSyncExterne @default(en_attente)
  tentatives      Int               @default(0)
  derniereErreur  String?           @map("derniere_erreur")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  evenement  Evenement?                 @relation(fields: [evenementId], references: [id], onDelete: SetNull)
  connexion  ConnexionCalendrierExterne @relation(fields: [connexionId], references: [id], onDelete: Cascade)

  @@unique([evenementId, connexionId])
  @@index([statut])
  @@map("evenement_sync_externe")
}

// Suivi interne des honoraires/paiements. Ce n'est PAS une facture
// normalisee au sens fiscal beninois (SYGMEF) : la facture officielle
// reste emise separement par l'avocat sur son propre compte SYGMEF. Ce
// document sert au cabinet pour le suivi (montant, statut, envoi client).
// Lot 14 : origine d'une SaisieTemps - "chrono" = demarree/arretee via le
// chronometre persistant (demarreA renseigne), "manuel" = saisie directe en
// rattrapage (dureeMinutes renseignee directement, demarreA/arreteA null -
// pas d'instant precis a preserver, juste une duree).
enum SourceSaisieTemps {
  chrono
  manuel
}

// Temps passe par un utilisateur sur un dossier (et optionnellement une
// action precise). Chronometre persistant cote serveur (voir
// routes/saisiesTemps.ts) : "en cours" = demarreA renseigne ET arreteA
// null - un utilisateur ne peut avoir qu'UNE SEULE saisie dans cet etat a
// la fois (verifie cote application avant creation, voir README-LOT14.md
// pour la justification de ce choix plutot qu'une contrainte DB).
model SaisieTemps {
  id       String            @id @default(uuid())
  cabinetId String           @map("cabinet_id")
  dossierId String           @map("dossier_id")
  actionId  String?          @map("action_id")
  userId    String           @map("user_id")
  source    SourceSaisieTemps @default(manuel)
  // Jour calendaire auquel ce temps est rattache, independant de l'heure
  // precise demarreA/arreteA - c'est le champ utilise pour l'agregation par
  // periode (feuilles de temps hebdomadaires/mensuelles) et pour dater une
  // saisie manuelle en rattrapage (l'utilisateur choisit le jour concerne,
  // pas forcement aujourd'hui).
  date      DateTime
  // Renseignes uniquement pour une saisie chronometree - arreteA reste null
  // tant que le chronometre n'est pas definitivement arrete. demarreA
  // marque le debut du segment EN COURS : non-null + arreteA null =
  // chronometre EN COURS ; demarreA null + arreteA null = chronometre EN
  // PAUSE (jamais l'etat d'une ligne fraichement creee - POST .../demarrer
  // le cree toujours avec demarreA deja renseigne, voir routes/saisiesTemps.ts) ;
  // arreteA non-null = definitivement arrete.
  demarreA DateTime? @map("demarre_a")
  arreteA  DateTime? @map("arrete_a")
  // Duree cumulee (en secondes) des segments PRECEDENTS deja clos par une
  // mise en pause - n'inclut JAMAIS le segment en cours (voir demarreA
  // ci-dessus). Une pause/reprise ne cree jamais une nouvelle SaisieTemps :
  // le meme enregistrement accumule ses segments successifs jusqu'a l'arret
  // definitif, qui calcule alors dureeMinutes = accumulee + segment en cours.
  dureeAccumuleeSecondes Int @default(0) @map("duree_accumulee_secondes")
  // Toujours renseignee une fois la saisie terminee (chrono arrete, ou
  // saisie manuelle directe) - null uniquement pendant qu'un chronometre
  // tourne. Arrondie a la minute la plus proche (voir services/feuillesTemps.ts,
  // arrondirMinutes()) - jamais d'ecart entre l'affichage et la facturation.
  dureeMinutes Int? @map("duree_minutes")
  description  String?
  // Certaines saisies (recherche interne, formation) ne sont jamais
  // facturees au client mais restent visibles dans les statistiques
  // internes de charge de travail - jamais retirees de l'agregation,
  // seulement exclues du montant facturable et de "Facturer ce dossier".
  facturable Boolean @default(true)
  // Snapshot du taux horaire de l'utilisateur (FCFA/heure) AU MOMENT de la
  // creation de cette saisie - une modification ulterieure de
  // User.tauxHoraireDefaut ne change JAMAIS retroactivement la valorisation
  // d'une saisie deja enregistree. Null si l'utilisateur n'avait pas de
  // taux configure a cet instant (saisie alors non valorisable en FCFA,
  // mais toujours comptabilisee en duree).
  tauxHoraireApplique Int? @map("taux_horaire_applique")
  // Renseigne une fois cette saisie incluse dans une facture generee (voir
  // routes/factures.ts, "Facturer ce dossier") - exclut alors definitivement
  // cette saisie de toute nouvelle facturation (evite un double comptage).
  factureId String?  @map("facture_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cabinet Cabinet  @relation(fields: [cabinetId], references: [id])
  dossier Dossier  @relation(fields: [dossierId], references: [id])
  action  Action?  @relation(fields: [actionId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  facture Facture? @relation(fields: [factureId], references: [id])

  @@index([cabinetId])
  @@index([dossierId])
  @@index([userId])
  @@index([factureId])
  @@map("saisies_temps")
}

model Facture {
  id                String        @id @default(uuid())
  cabinetId         String        @map("cabinet_id")
  // Optionnel : une facture (notamment une proforma) peut concerner un
  // client sans dossier encore ouvert.
  dossierId         String?       @map("dossier_id")
  // Nom du client tel que saisi/choisi au moment de la facture - independant
  // du dossier, pour couvrir le cas d'un prospect pas encore en base.
  // Nullable en base pour les factures creees avant l'ajout de ce champ
  // (toujours fourni obligatoirement a la creation via l'API).
  clientNom         String?       @map("client_nom")
  numero            String
  description       String
  // Montant Hors Taxes en Francs CFA.
  montant           Int
  appliquerTva      Boolean       @default(false) @map("appliquer_tva")
  estProforma       Boolean       @default(false) @map("est_proforma")
  dateEmission      DateTime      @default(now()) @map("date_emission")
  dateEcheance      DateTime?     @map("date_echeance")
  statut            FactureStatut @default(brouillon)
  destinataireEmail String?       @map("destinataire_email")
  envoyeAt          DateTime?     @map("envoye_at")
  payeeAt           DateTime?     @map("payee_at")
  createdBy         String        @map("created_by")
  createdAt         DateTime      @default(now()) @map("created_at")

  cabinet Cabinet  @relation(fields: [cabinetId], references: [id])
  dossier Dossier? @relation(fields: [dossierId], references: [id])
  creePar User     @relation("FactureCreatedBy", fields: [createdBy], references: [id])
  // Lot 14 : saisies de temps incluses dans cette facture (generee via
  // "Facturer ce dossier" depuis le temps passe) - vide pour une facture
  // creee manuellement comme avant ce lot.
  saisiesTemps SaisieTemps[]
  // Rappels de paiement (pop-up du tableau de bord) ecartes definitivement
  // par un ou plusieurs utilisateurs pour cette facture precise.
  rappelsIgnores FactureRappelIgnore[]

  @@unique([cabinetId, numero])
  @@index([dossierId])
  @@map("factures")
}

// Rappel de paiement (pop-up "Factures en attente" du tableau de bord)
// ecarte definitivement par UN utilisateur pour UNE facture - jamais
// partage entre utilisateurs du cabinet (chaque avocat/titulaire decide
// pour lui-meme, voir routes/factures.ts). Redevient visible si la facture
// est modifiee/remise a "envoyee" apres avoir ete payee puis rouverte -
// n'est jamais supprime automatiquement, seulement par cascade si la
// facture ou l'utilisateur est supprime.
model FactureRappelIgnore {
  id        String   @id @default(uuid())
  factureId String   @map("facture_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([factureId, userId])
  @@map("facture_rappels_ignores")
}

model Action {
  id                    String       @id @default(uuid())
  dossierId             String       @map("dossier_id")
  typeAction            TypeAction   @map("type_action")
  canal                 Canal
  contenuGenere         String?      @map("contenu_genere") // [chiffre-au-repos]
  dateAudience          DateTime?    @map("date_audience")
  prochaineAudience     DateTime?    @map("prochaine_audience")
  piecesPrevoir         String?      @map("pieces_prevoir")
  // Le cabinet a explicitement decide de ne pas reprendre cette prochaine
  // audience dans le role de la semaine (evite qu'une suggestion ecartee
  // ne revienne systematiquement).
  ignorerSuggestionRole Boolean      @default(false) @map("ignorer_suggestion_role")
  // Statut de validation/envoi (remplace l'envoi automatique par mail).
  statut                StatutAction @default(brouillon)
  // Orphelines (Lot 8ter) : alimentees par l'ancien callback de generation
  // du document Google Docs (n8n), retire du produit - l'export Word/PDF
  // natif suffit. Toujours null desormais. Conservees sans migration de
  // suppression, non necessaire (voir README-LOT8TER.md).
  documentUrl           String?      @map("document_url")
  documentId            String?      @map("document_id")
  destinataireEmail     String?      @map("destinataire_email")
  envoyeAt              DateTime?    @map("envoye_at")
  // Copie brute des champs saisis dans le formulaire (uniquement pour les
  // Conclusions pour l'instant) - permet de pre-remplir un autre document
  // du meme dossier (ex: Note de plaidoirie) sans tout ressaisir.
  champsFormulaire      Json?        @map("champs_formulaire")
  // Copie des champs composes envoyes a n8n pour remplir les balises du
  // template Google Docs (identite des parties, huissier, greffier, juge,
  // civilites, adresses...) - contrairement a champsFormulaire (saisie brute
  // du formulaire), ces valeurs sont deja resolues (fiche client en base,
  // parametres du cabinet, formules composees) et servent a reconstruire le
  // meme formalisme juridique dans les exports Word/PDF locaux (voir
  // documentFormalisme.ts). Absent pour les types de documents sans
  // formalisme specifique (recherche, traduction, resume...).
  champsDocument        Json?        @map("champs_document") // [chiffre-au-repos]
  // Lot 5 : true si ce document a ete genere via le module de
  // pseudonymisation (server/src/security/anonymizer.ts) avant l'appel LLM
  // - false pour les types d'actes qui n'envoient aucune donnee
  // identifiante au LLM (assignation, conclusions...) ou generes avant ce
  // lot. Purement informatif/tracabilite, n'influence aucune logique.
  donneesPseudonymisees Boolean      @default(false) @map("donnees_pseudonymisees")
  // Nom "humain" du document genere (ex: "Assignation_KODJO Marcelline
  // contre AGBODJAN Serge") - distingue chaque document du meme type par
  // les noms des parties, utilise pour le titre du Google Doc (n8n) et pour
  // le nom de fichier des exports Word/PDF locaux.
  nomDocument           String?      @map("nom_document")
  createdBy             String       @map("created_by")
  createdAt             DateTime     @default(now()) @map("created_at")
  // Lot 11 (Partie A) : verrouillage sequentiel - une seule personne peut
  // editer un document a la fois. verrouillePar = id de l'utilisateur qui
  // detient le verrou (null = libre), verrouilleLe = date de prise, utilisee
  // par le job de liberation automatique (voir jobs/liberationVerrousExpires.ts).
  verrouillePar    String?   @map("verrouille_par")
  verrouilleLe     DateTime? @map("verrouille_le")
  // Numero de la derniere ActionVersion creee pour ce document (0 = jamais
  // edite via le systeme de versions - contenuGenere est alors simplement le
  // contenu d'origine, genere par IA ou par le gabarit de redaction libre).
  versionActuelle  Int       @default(0) @map("version_actuelle")
  // Lot 11 (Partie B) : "genere_ia" (defaut, comportement historique
  // inchange) ou "redaction_libre" (aucun appel LLM, aucun champsDocument -
  // voir services/gabaritsRedactionLibre.ts). Jamais modifie apres creation.
  modeCreation     String    @default("genere_ia") @map("mode_creation")

  dossier               Dossier               @relation(fields: [dossierId], references: [id])
  creePar               User                  @relation("ActionCreatedBy", fields: [createdBy], references: [id])
  verrouilleParUtilisateur User?               @relation("ActionVerrouillePar", fields: [verrouillePar], references: [id])
  auditLogs             AuditLog[]
  commentaires          CommentaireRevision[]
  versions              ActionVersion[]
  // Lot 14 : saisies de temps rattachees precisement a cette action (en
  // plus du dossier) - optionnel, une saisie peut ne concerner que le
  // dossier dans son ensemble (dossierId seul, actionId null).
  saisiesTemps          SaisieTemps[]

  @@index([dossierId])
  @@index([createdBy])
  @@map("actions")
}

// Lot 11 (Partie A) : historique complet des versions d'un document, une
// ligne par sauvegarde explicite (jamais d'autosave). contenuGenere sur
// Action reflete TOUJOURS la derniere version VALIDEE (jamais la derniere
// version enregistree) - documentExport.ts/documentFormalisme.ts continuent
// donc de lire Action.contenuGenere sans aucune modification. Jamais
// supprimee (meme remplacee par une version plus recente) : tracabilite,
// meme raisonnement que CommentaireRevision (Lot 10). Voir README-LOT11.md.
model ActionVersion {
  id                String   @id @default(uuid())
  actionId          String   @map("action_id")
  numero            Int
  contenu           String
  auteurId          String   @map("auteur_id")
  estVersionValidee Boolean  @default(false) @map("est_version_validee")
  createdAt         DateTime @default(now()) @map("created_at")

  action Action @relation(fields: [actionId], references: [id])
  auteur User   @relation("ActionVersionAuteur", fields: [auteurId], references: [id])

  @@index([actionId])
  @@map("action_versions")
}

// Lot 10 : remarque de revision laissee par un avocat/titulaire sur un
// document en_attente_validation ("corrige ce passage", "attention a ce
// point") - scope V1 volontairement limite a des remarques generales sur
// le document entier, pas d'ancrage sur un passage de texte precis (evite
// la fragilite d'un ancrage dans un editeur Markdown en texte libre - voir
// README-LOT10.md). Jamais supprimee, meme resolue : tracabilite de la
// relecture en cas de litige sur la qualite d'un acte.
model CommentaireRevision {
  id             String    @id @default(uuid())
  actionId       String    @map("action_id")
  auteurId       String    @map("auteur_id")
  contenu        String
  // "ouvert" | "resolu"
  statut         String    @default("ouvert")
  dateCreation   DateTime  @default(now()) @map("date_creation")
  dateResolution DateTime? @map("date_resolution")
  resoluParId    String?   @map("resolu_par_id")

  action    Action @relation(fields: [actionId], references: [id])
  auteur    User   @relation("CommentaireRevisionAuteur", fields: [auteurId], references: [id])
  resoluPar User?  @relation("CommentaireRevisionResoluPar", fields: [resoluParId], references: [id])

  @@index([actionId])
  @@map("commentaires_revision")
}

model AuditLog {
  id        String          @id @default(uuid())
  actionId  String          @map("action_id")
  etape     String
  statut    StatutExecution
  detail    String?
  timestamp DateTime        @default(now())

  action Action @relation(fields: [actionId], references: [id])

  @@index([actionId])
  @@map("audit_logs")
}

model JurisprudenceChunk {
  id           String                 @id @default(uuid())
  source       String
  reference    String
  juridiction  String?
  dateDecision String?                @map("date_decision")
  contenu      String
  embedding    Unsupported("vector")?
  createdAt    DateTime               @default(now()) @map("created_at")
  // Lot 13 : lien reel et verifiable vers la decision elle-meme - absent du
  // schema avant ce lot (verifie : aucun champ url/lien/source-lien
  // preexistant, "source" ci-dessus n'est qu'un libelle - ex. "Cour Supreme
  // du Benin" - jamais une URL). Nullable : les chunks indexes avant ce lot
  // n'ont pas ce champ renseigne - voir README-LOT13.md pour l'impact sur
  // le corpus existant. Un chunk cite sans lien est traite comme non
  // source a l'affichage (services/jurisprudence/grounding.ts), jamais
  // affiche sans lien verifie.
  lien         String?

  @@map("jurisprudence_chunks")
}
