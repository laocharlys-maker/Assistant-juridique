{
  "name": "aurore-backend",
  "version": "0.1.1",
  "description": "Backend Aurore - orchestration metier et IA pour le cabinet KOFFI & ASSOCIES",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx prisma/seedSuperAdmin.ts",
    "prisma:portable-sql": "prisma migrate diff --from-empty --to-schema-datamodel=prisma/schema.prisma --script > prisma/portable-init.sql",
    "postgres:download-binaries": "node scripts/download-postgres-binaries.js",
    "postgres:restore-backup": "node scripts/restore-backup.js",
    "build:sea": "npm run prisma:generate && npm run prisma:portable-sql && npm run build && node scripts/build-sea.js",
    "security-audit": "node scripts/security-audit.js",
    "test:e2e": "vitest run tests/e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "bonjour-service": "^1.4.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.0",
    "imapflow": "^1.6.6",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.15",
    "mammoth": "^1.12.0",
    "marked": "^18.0.7",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^1.1.4",
    "pdf-to-png-converter": "^4.2.0",
    "pdfkit": "^0.19.1",
    "selfsigned": "^5.5.0",
    "tesseract.js": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.7.4",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "extract-zip": "^2.0.1",
    "javascript-obfuscator": "^5.5.0",
    "postject": "^1.0.0-alpha.6",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true
  }
}
