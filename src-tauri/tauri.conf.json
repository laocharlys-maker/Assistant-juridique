{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurore",
  "version": "0.1.0",
  "identifier": "com.aurore.desktop",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aurore",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "externalBin": [
      "binaries/aurore-backend"
    ],
    "resources": {
      "../backend/dist-sea/public": "public",
      "../backend/dist-sea/node_modules": "node_modules",
      "../backend/dist-sea/.env": ".env",
      "../backend/dist-sea/postgres": "postgres",
      "../backend/dist-sea/prisma": "prisma"
    }
  }
}
